library(birdcolors)
xx <- rnorm(100,0,1)
yy <- runif(100,-4,4)
plot(xx,yy)
sp <- sample(c("Varied Thrush","Sagebrush Sparrow","Painted Bunting"),100,replace=TRUE)
plot(xx,yy)
plot(xx,yy,col=as.factor(sp))
plot(xx,yy)
as.factor(sp)
legend(rev(c("Varied Thrush","Sagebrush Sparrow","Painted Bunting")))
legend(legend=rev(c("Varied Thrush","Sagebrush Sparrow","Painted Bunting")))
plot(xx,yy,col=as.factor(sp))
bc <- bird_colors("Thick_billed_Euphonia")
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Paradise Tanger")
bc <- bird_colors("Paradise Tanager")
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground Roller")
bc <- bird_colors("Scaly Ground-Roller")
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(1,3,6)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(1,2,6)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(1,2,4)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(1,8,4)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(1,3,4)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
bc <- bird_colors("Scaly Ground-Roller")[c(2,3,4)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=col_converter)
library(birdcolors)
library(ggplot2)
xx <- rnorm(100,0,1)
yy <- runif(100,-4,4)
sp <- sample(c("Varied Thrush","Sagebrush Sparrow","Painted Bunting"),
100,replace=TRUE)
plot(xx,yy)
plot(xx,yy,col=as.factor(sp))
bc <- bird_colors("Scaly Ground-Roller")[c(2,3,4)]
col_converter <- bc[as.numeric(as.factor(sp))]
plot(xx,yy,pch=19,col=alpha(col_converter,.4))
plot(xx,yy,pch=19,col=alpha(col_converter,.75))
