# Create ggplot color gradient
scale_color_bird <- function(outp) {
colpal <- grDevices::colorRampPalette(outp, space = "Lab")
ggplot2::scale_colour_gradientn(
colours = colpal(300)
)
}
# Create ggplot fill gradient
scale_fill_bird <- function(outp) {
colpal <- grDevices::colorRampPalette(outp, space = "Lab")
ggplot2::scale_fill_gradientn(
colours = colpal(300)
)
}
